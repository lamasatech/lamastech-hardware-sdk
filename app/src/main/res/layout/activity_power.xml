<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Power Controls"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReboot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reboot" />

        <Button
            android:id="@+id/btnShutdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shutdown" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule Reboot"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Delay in seconds (default: 60)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnScheduleReboot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule Reboot" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn Off / On Alarm"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOffTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Off time HH:mm (default: 22:00)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etOnTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="On time HH:mm (default: 08:00)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSetAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Turn Off/On Alarm" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto Power On/Off"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAutoPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Auto Power On/Off (Mon-Fri, 8:00-22:00)" />

        <CheckBox
            android:id="@+id/cbAutoPowerEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable"
            android:checked="true"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etAutoWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Week mask Sun-Sat, e.g. 1,1,1,1,1,0,0 (blank = every day)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etAutoOnTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Power on time HH:mm (default: 08:00)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etAutoOffTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Power off time HH:mm (default: 22:00)"
            android:inputType="text" />

        <Button
            android:id="@+id/btnAutoPowerCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Custom Auto Power Schedule" />

        <Button
            android:id="@+id/btnAutoPowerDisable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable Auto Power On/Off" />

        <Button
            android:id="@+id/btnGetAutoPowerSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get Auto Power Schedule" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="12dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
